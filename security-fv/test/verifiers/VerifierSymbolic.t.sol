        for (uint256 k = 0; k < 6; k++) pub[k] = bytes32(s[k]);
        // echo returns true iff it received exactly (pA,pB,pC,s) in this order
        assertTrue(v.verify(abi.encode(pA, pB, pC), pub));
    }

    /// Foundry fuzz twin of the two P1 checks (random proof + one forced non-canonical signal).
    function testFuzz_consolidate_noncanonical(
        uint256[2] memory pA, uint256[2][2] memory pB, uint256[2] memory pC, uint256[6] memory s, uint256 i, uint256 x
    ) public {
        i = bound(i, 0, 5);
        s[i] = R + bound(x, 0, type(uint256).max - R);
        check_consolidate_base_rejects_noncanonical(pA, pB, pC, s);
        check_consolidate_adapter_rejects_noncanonical(pA, pB, pC, s);
    }

}  // contract VerifierSymbolic


